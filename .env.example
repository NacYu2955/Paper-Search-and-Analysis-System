DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PDF_CONTEXT_MAX_CHARS=20000

MODEL_PATH=model/all-MiniLM-L6-v2
SELECTOR_PATH=model/selector
DATABASE_PATH=src/papers.db
TESTSET_PATH=dataset/testset.jsonl

USE_COS_STORAGE=false
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=

RAG_ENABLE_MILVUS=true
RAG_ENABLE_IN_MEMORY_FALLBACK=true
RAG_MILVUS_URI=output/rag/milvus.db
RAG_MILVUS_COLLECTION=pasa_papers
